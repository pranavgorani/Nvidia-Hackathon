# ==============================================================================
# DocuFlow AI Agent OS — Environment Configuration Template
# ==============================================================================

# AI Inference Provider Configuration
# Supported provider: google_gemini
AI_PROVIDER=google_gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Application Configuration
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Defaults to SQLite local storage; can point to PostgreSQL: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./docuflow.db

# Storage Configuration
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Agent Policy Controls
MAX_AGENT_TURNS=15
TOOL_EXECUTION_TIMEOUT_SECONDS=45
REQUIRE_APPROVAL_FOR_WRITES=true
APPROVAL_EXPIRY_HOURS=24

